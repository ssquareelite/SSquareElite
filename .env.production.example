# ---- Reference only ----
# On GoDaddy Node.js Hosting, DB_HOST / DB_PORT / DB_NAME / DB_USER / DB_PASSWORD
# are created and injected automatically by GoDaddy's managed MySQL — you do NOT
# set these yourself in Secrets. Only add the variables below.

CLIENT_URL=https://ssquareelite.online

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=PUT_A_LONG_RANDOM_STRING_HERE
JWT_EXPIRES_IN=7d

# Stripe LIVE keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_your_key_here

# Create a webhook endpoint pointing to:
#   https://ssquareelite.online/api/checkout/webhook
# then paste its signing secret here.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
