# Server
PORT=3000
CLIENT_URL=http://localhost:3000

# MySQL — on GoDaddy Node.js Hosting, DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD
# are provisioned and injected automatically; you don't set them yourself there.
# For local development, point these at any MySQL server you have running.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_local_mysql_password
DB_NAME=toyland

# Auth
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_your_key_here
# From `stripe listen --forward-to localhost:3000/api/checkout/webhook`
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
